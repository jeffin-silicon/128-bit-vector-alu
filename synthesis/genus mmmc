#============================================================
# MMMC Configuration
# Design     : 128-bit Vector/SIMD ALU
# Technology : 45nm
#============================================================

#============================================================
# Library Sets
#============================================================

create_library_set -name slow_lib \
    -timing {
        ./libs/slow.lib
    }

create_library_set -name fast_lib \
    -timing {
        ./libs/fast.lib
    }

#============================================================
# RC Corners
#============================================================

create_rc_corner -name rc_slow

create_rc_corner -name rc_fast

#============================================================
# Delay Corners
#============================================================

create_delay_corner -name slow_corner \
    -library_set slow_lib \
    -rc_corner rc_slow

create_delay_corner -name fast_corner \
    -library_set fast_lib \
    -rc_corner rc_fast

#============================================================
# Constraint Mode
#============================================================

create_constraint_mode -name func_mode \
    -sdc_files {
        ./constraints/simd_alu_128.sdc
    }

#============================================================
# Analysis Views
#============================================================

create_analysis_view -name setup_view \
    -constraint_mode func_mode \
    -delay_corner slow_corner

create_analysis_view -name hold_view \
    -constraint_mode func_mode \
    -delay_corner fast_corner

#============================================================
# Active Analysis Views
#============================================================

set_analysis_view \
    -setup {setup_view} \
    -hold  {hold_view}
